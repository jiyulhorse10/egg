-- 기능 A: 텔레포트 (TP)
CreateButton("📍 Teleport to Eggs", UDim2.new(0, 10, 0, 0), function()
    print("⏳ TP 시작 중...")
    -- 모든 계란 찾기
    local eggs = workspace:FindFirstChildOfClass("Folder") or workspace.Eggs
    if not eggs then 
        -- 일반 폴더가 없을 경우 자식들 중 'Egg' 태그가 있거나 이름에 egg가 들어간 것 찾기
        eggs = workspace:FindChildren("BasePart")
    end
    
    local count = 0
    for _, part in pairs(workspace:GetDescendants()) do
        if part:IsA("BasePart") and string.lower(part.Name):find("egg") then
            -- 첫 번째 계란으로 이동 (모두로 TP하면 랙 걸릴 수 있음)
            HumanoidRootPart.CFrame = part.CFrame + Vector3.new(0, 2, 0)
            count = count + 1
            if count >= 1 then break end -- 최적화를 위해 첫 번째만 이동
        end
    end
    if count == 0 then print("❌ 계란을 찾지 못했습니다.") else print("✅ TP 완료!") end
end)

